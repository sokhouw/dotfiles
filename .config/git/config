[core]
    editor = nvim
    pager = cat
; [diff]
;     tool = vimdiff
[diff]
    tool = nvimdiff
[difftool "nvimdiff"]
    prompt = false
    cmd = nvim -d "$LOCAL" "$REMOTE"
[merge]
    tool = "nvim -d"
[mergetool]
    prompt = false
[format]
    pretty = format:%C(bold yellow)%h%C(reset) %C(green)%cr%C(reset)%x09 %C(blue)%an%C(reset) %s%C(auto)%d%C(reset)
[pager]
    log = cat && echo
