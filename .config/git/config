[push]
    default = current
[diff]
    tool = vimdiff
    patience = true
[difftool "vimdiff"]
    path = vimdiff
    cmd = vimdiff -u ~/.config/vim/vimrc "$LOCAL" "$REMOTE"
    prompt = false
[merge]
    tool = vimdiff
    patience = true
[mergetool "vimdiff"]
    path = vimdiff
    cmd = vimdiff -u ~/.config/vim/vimrc -f -d -c '4wincmd w | wincmd J' "$LOCAL" "$BASE" "$REMOTE" "$MERGED"
[mergetool]
    prompt = false
[apply]
    whitespace = nowarn
[init]
    templatedir = ~/.git-templates
[color]
    ui = auto
[format]
    pretty = format:%C(bold yellow)%h%C(reset) %C(green)%cr%C(reset)%x09 %C(blue)%an%C(reset) %s%C(auto)%d%C(reset)
[core]
    pager = cat && echo
